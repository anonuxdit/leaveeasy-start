// ─────────────────────────────────────────────────────────────
// firestore.rules — กฎเฝ้าข้อมูลของ LeaveEasy
// สัปดาห์ที่ 7: กฎขั้นต่ำ "ต้องล็อกอินก่อน ถึงอ่าน/เขียนได้" เท่านั้น
// ยังไม่แยกสิทธิ์ตาม role หรือเจ้าของเอกสาร (เป็นงานของสัปดาห์ที่ 8)
//
// วิธี publish: เปิด Firebase Console → Firestore Database → Rules
// แล้วคัดลอกเนื้อหาไฟล์นี้ไปวางแทนของเดิม แล้วกด Publish
// (เครื่องนี้ไม่มี Firebase CLI จึง deploy ผ่านคำสั่งไม่ได้ ต้อง publish ผ่านหน้าเว็บ)
// ─────────────────────────────────────────────────────────────
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
